  m_Name: WorldEndingCredits
  m_EditorClassIdentifier: Assembly-CSharp::EndingCreditsAsset
  text: "\u81F4 __\uFF1A\n\n\u8DDD\u79BB\u90A3\u5669\u68A6\u822C\u7684\u573A\u666F\uFF0C\u5DF2\u7ECF\u8FC7\u53BB\u534A\u5E74\u4E86\u3002\n\u8FD9\u534A\u5E74\u91CC\uFF0C\u6211\u4ECD\u7136\u65F6\u5E38\u4E60\u60EF\u6027\u5730\u547C\u5524\u7740\u4F60\u7684\u540D\u5B57\uFF0C\u76F4\u5230\u5C4B\u91CC\u7A7A\u843D\u843D\u7684\u6CA1\u6709\u56DE\u5E94\uFF0C\u624D\u60F3\u8D77\u4F60\u5DF2\u7ECF\u79BB\u53BB\u7684\u4E8B\u5B9E\u3002\u6709\u7684\u65F6\u5019\uFF0C\u6211\u603B\u4F1A\u5E7B\u60F3\u7740\uFF0C\u4F1A\u4E0D\u4F1A\u7B49\u6211\u54EA\u4E00\u5929\u6062\u590D\u4E86\u89C6\u529B\uFF0C\u6211\u5C31\u80FD\u518D\u4E00\u6B21\u770B\u89C1\u4F60\u4E86\u5462\uFF1F\u4F1A\u4E0D\u4F1A\uFF0C\u8FD9\u53EA\u4E0D\u8FC7\u662F\u4F60\u5411\u6211\u5F00\u7684\u4E00\u4E2A\u5C0F\u73A9\u7B11\uFF0C\u5728\u8FD9\u4E9B\u65F6\u5019\uFF0C\u5176\u5B9E\u4F60\u53EA\u662F\u5728\u6211\u8EAB\u540E\u5077\u7B11\u5462\uFF1F\n\n\u53EF\u6211\u662F\u90A3\u4E48\u5730\u4E86\u89E3\u4F60\uFF0C\u4F60\u4ECE\u6765\u53EA\u4F1A\u4ECE\u80CC\u540E\u8F7B\u8F7B\u5730\u5C06\u6211\u62B1\u4F4F\uFF0C\u544A\u8BC9\u6211\u4E00\u5207\u90FD\u4F1A\u597D\u8D77\u6765\u7684\u3002\n\n\u53EF\u5C31\u662F\u8FD9\u6837\u4E00\u4E2A\u53EF\u7231\u7684\u3001\u6E29\u67D4\u7684\u3001\u544A\u8BC9\u6211\u4E00\u5207\u4F1A\u597D\u8D77\u6765\u7684\u4EBA\uFF0C\u5374\u5728\u90A3\u5145\u65A5\u7740\u5404\u79CD\u5608\u6742\u58F0\u97F3\u7684\u4E00\u77AC\u91CC\uFF0C\u8F7B\u98D8\u98D8\u5730\u79BB\u6211\u800C\u53BB\u4E86\u3002\n\n\u533B\u751F\u8BF4\u6211\u7684\u773C\u775B\u6CA1\u6709\u95EE\u9898\uFF0C\u5931\u660E\u662F\u5FC3\u56E0\u6027\u7684\u3002\u4ED6\u4E3A\u6211\u5F00\u4E86\u51E0\u76D2\u4F0F\u786B\u897F\u6C40\uFF0C\u8BF4\u8FD9\u6216\u8BB8\u80FD\u7F13\u89E3\u6211\u7684\u60C5\u51B5\u3002\u6211\u8D77\u521D\u603B\u662F\u7528\u5404\u79CD\u7406\u7531\u62D6\u5EF6\u5403\u836F\u3002\u6211\u6015\u4E00\u7741\u773C\u770B\u4E0D\u5230\u4F60\uFF0C\u6211\u6015\u8FD9\u6837\u7684\u771F\u76F8\u8D64\u88F8\u88F8\u5730\u5C55\u73B0\u5728\u6211\u773C\u524D\uFF0C\u6211\u65E0\u6CD5\u63A5\u53D7\u4F60\u79BB\u53BB\u7684\u4E8B\u5B9E\uFF0C\u6211\u6015\u8EAB\u8FB9\u7684\u4E00\u5207\u90FD\u5728\u63D0\u9192\u6211\u4E4B\u540E\u518D\u4E5F\u4E0D\u4F1A\u6709\u6211\u4EEC\u7684\u6545\u4E8B\u4E86\u3002\u6211\u66F4\u6015\u836F\u7269\u7684\u6297\u6291\u90C1\u529F\u6548\u4F1A\u8BA9\u6211\u5FD8\u8BB0\u5BF9\u4F60\u7684\u8FD9\u4E9B\u60C5\u611F\u3002\u5728\u90A3\u6F2B\u957F\u7684\u516D\u4E2A\u6708\u91CC\uFF0C\u6211\u90FD\u4EE5\u8FD9\u79CD\u81EA\u6B3A\u7684\u65B9\u5F0F\u5B58\u5728\u7740\u3002\n\u6211\u4E5F\u60F3\u8FC7\u4ECE\u7A97\u6237\u8DF3\u4E0B\uFF0C\u53BB\u5F80\u4F60\u6240\u5728\u7684\u90A3\u4E2A\u4E16\u754C\uFF0C\u6C38\u8FDC\u6C89\u5165\u8FD9\u7247\u65E0\u5149\u7684\u6DF1\u6E0A\u3002\u8981\u662F\u4F60\u5728\u7684\u8BDD\uFF0C\u4E00\u5B9A\u4F1A\u5F88\u4E25\u8083\u5730\u5236\u6B62\u6211\u7684\u8FD9\u79CD\u60F3\u6CD5\u5427\u3002\n\n\u8BF7\u653E\u5FC3\uFF0C\u73B0\u5728\u7684\u6211\u5DF2\u7ECF\u4E0D\u4F1A\u518D\u90A3\u6837\u60F3\u4E86\u3002\n\n\u521A\u5F00\u59CB\u7684\u65F6\u95F4\u91CC\uFF0C\u6211\u603B\u662F\u62FC\u4E86\u547D\u5730\u64AD\u653E\u8BB0\u5F55\u7740\u4F60\u58F0\u97F3\u7684\u97F3\u9891\uFF0C\u8BED\u97F3\u4E5F\u597D\uFF0C\u89C6\u9891\u4E5F\u597D\uFF0C\u5C31\u597D\u50CF\u4F60\u8FD8\u5728\u6211\u8EAB\u8FB9\u4E00\u6837\u3002\u4F60\u9AD8\u4E2D\u65F6\u9001\u6211\u7684\u6BDB\u7ED2\u5C0F\u718A\u6211\u4E5F\u8FD8\u4E00\u76F4\u7559\u7740\uFF0C\u4E00\u5F00\u59CB\u6211\u603B\u662F\u62B1\u7740\u5B83\u4E00\u76F4\u6309\uFF0C\u8BA9\u58F0\u97F3\u5145\u6EE1\u6574\u4E2A\u623F\u95F4\uFF0C\u8FD9\u662F\u5C11\u6570\u80FD\u8BA9\u6211\u611F\u5230\u5B89\u5168\u7684\u58F0\u97F3\u3002\n\u540E\u6765\u6211\u6E10\u6E10\u5F00\u59CB\u62C5\u5FC3\u5B83\u4F1A\u574F\u6389\uFF0C\u4E8E\u662F\u5C31\u65F6\u4E0D\u65F6\u62FF\u51FA\u6765\u6309\u4E00\u4E0B\uFF0C\u52A8\u4F5C\u4E5F\u5F88\u5C0F\u5FC3\uFF0C\u53EF\u662F\u6709\u4E00\u5929\u5B83\u8FD8\u662F\u4E0D\u53D1\u58F0\u4E86\u3002\u6211\u8FD8\u8BB0\u5F97\u90A3\u5929\u6211\u65E0\u52A9\u5730\u9760\u5750\u5728\u5899\u8FB9\u5927\u54ED\u4E86\u4E00\u6574\u5929\uFF0C\u628A\u670B\u53CB\u4EEC\u90FD\u5413\u574F\u4E86\u3002\u6211\u4E5F\u4E0D\u77E5\u9053\u6211\u4E3A\u4EC0\u4E48\u800C\u54ED\uFF0C\u53EA\u662F\u611F\u89C9\u5F80\u65E5\u79EF\u538B\u5728\u9EBB\u6728\u7684\u5E73\u9759\u4E2D\u7684\u60B2\u4F24\u5728\u90A3\u4E00\u523B\u503E\u6CFB\u800C\u51FA\u3002\n\n\u4E4B\u540E\uFF0C\u6211\u7684\u751F\u6D3B\u4F3C\u4E4E\u7A0D\u5FAE\u56DE\u5F52\u4E86\u4E00\u4E9B\u6B63\u8F68\uFF0C\u4F46\u90A3\u5929\u91D1\u5C5E\u7684\u6495\u88C2\u58F0\u3001\u6025\u4FC3\u7684\u5239\u8F66\uFF0C\u4ECD\u7136\u662F\u6C38\u4E0D\u7184\u706D\u7684\u6697\u54CD\uFF0C\u5728\u6211\u4F53\u5185\u4E0D\u65AD\u7FFB\u6D8C\u7740\u3002\u4EFB\u4F55\u5C16\u9510\u7684\u54CD\u52A8\uFF0C\u90FD\u4F1A\u5728\u9ED1\u6697\u91CC\u70B8\u5F00\u523A\u76EE\u7684\u767D\u5149\uFF0C\u5C06\u6211\u751F\u751F\u62FD\u56DE\u90A3\u4E2A\u4E0B\u5348\u3002\u6211\u4EB2\u624B\u7838\u788E\u4E86\u80FD\u53D1\u51FA\u5C16\u9510\u58F0\u54CD\u7684\u4E00\u5207\uFF0C\u6B7B\u6B7B\u6263\u7740\u8033\u7F69\uFF0C\u628A\u5168\u4E16\u754C\u7684\u58F0\u54CD\u9694\u7EDD\u5728\u5916\u3002\u6211\u4EE5\u4E3A\u53EA\u8981\u542C\u4E0D\u5230\uFF0C\u53EA\u8981\u8BA9\u4E16\u754C\u9677\u5165\u7EDD\u5BF9\u7684\u9ED1\uFF0C\u6211\u5C31\u80FD\u5047\u88C5\u4F60\u8FD8\u5728\u3002\n\n\u76F4\u5230\u6211\u8D70\u8FDB\u4E86\u90A3\u4E9B\u8BB0\u5FC6\u7684\u5E9F\u589F\u3002\n\u5728\u90A3\u4E9B\u5168\u9ED1\u7684\u623F\u95F4\u91CC\uFF0C\u6211\u9760\u7740\u4F60\u7559\u4E0B\u7684\u56DE\u54CD\uFF0C\u4E00\u70B9\u70B9\u627E\u56DE\u4E86\u88AB\u6211\u4EB2\u624B\u57CB\u846C\u7684\u8FC7\u53BB\u3002\n\u6211\u542C\u89C1\u4E86\u4F60\u585E\u8FDB\u6211\u6000\u91CC\u7684\u90A3\u4E2A\u73A9\u5076\uFF0C\u53D1\u51FA\u7684\u7B2C\u4E00\u58F0\u7F9E\u6DA9\u7684\u8F7B\u54CD\uFF1B\n\u542C\u89C1\u4E86\u56FE\u4E66\u9986\u91CC\u4F60\u624B\u8098\u78B0\u843D\u6C34\u676F\u65F6\uFF0C\u90A3\u58F0\u9065\u8FDC\u7684\u8106\u54CD\uFF1B\n\u6211\u751A\u81F3\u68A6\u5230\u4E86\u6211\u4EEC\u672A\u80FD\u4E3E\u529E\u7684\u5A5A\u793C\uFF0C\u542C\u89C1\u4E86\u6211\u4EEC\u5728\u865A\u5E7B\u7684\u68A6\u5883\u4E2D\uFF0C\u88AB\u4F4E\u9891\u8033\u9E23\u6DF9\u6CA1\u7684\u3001\u6C38\u8FDC\u65E0\u6CD5\u62B5\u8FBE\u7684\u8A93\u8A00\u3002\n\u4EE5\u53CA\uFF0C\u90A3\u4E2A\u6700\u7EC8\u5C06\u6211\u51FB\u788E\u7684\u4E00\u9053\u6F2B\u957F\u3001\u51B0\u51B7\u3001\u523A\u8033\u7684\u957F\u97F3\u3002\n\n\u6211\u542C\u5230\u6211\u7684\u4E00\u5207\u75DB\u82E6\u4E0E\u60B2\u4F24\u51DD\u7ED3\u6210\u4F4E\u9891\u7684\u566A\u97F3\u5982\u6D9F\u6F2A\u822C\u88AD\u6765\u3002\n\u4F46\u6211\u603B\u7B97\u6CA1\u6709\u9003\u8D70\u3002\n\n\u6211\u603B\u60F3\u628A\u81EA\u5DF1\u7559\u5728\u8FC7\u53BB\uFF0C\u518D\u591A\u542C\u4E00\u542C\u4F60\u7684\u58F0\u97F3\uFF0C\u518D\u591A\u770B\u4E00\u770B\u6211\u4EEC\u8FC7\u53BB\u7684\u6545\u4E8B\u3002\u4F46\u5F53\u6211\u627E\u5230\u90A3\u679A\u4F60\u85CF\u5728\u8863\u67DC\u91CC\u7684\u6212\u6307\u65F6\uFF0C\u6211\u60F3\uFF0C\u6211\u5DF2\u7ECF\u8BFB\u61C2\u4E86\u4F60\u672A\u66FE\u8BF4\u51FA\u53E3\u7684\u8BDD\u3002\u539F\u6765\uFF0C\u6211\u65E0\u987B\u518D\u9003\u907F\u3002\n\u4F60\u7559\u4E0B\u7684\u58F0\u97F3\uFF0C\u8DB3\u4EE5\u652F\u6491\u6211\u7EE7\u7EED\u8D70\u4E0B\u53BB\uFF0C\u7167\u4EAE\u6211\u7684\u4F59\u751F\u3002\n\n\u73B0\u5728\u6211\u5DF2\u7ECF\u53EF\u4EE5\u770B\u5230\u4E00\u4E9B\u6A21\u7CCA\u7684\u4E8B\u7269\uFF0C\u4E0D\u518D\u9700\u8981\u670D\u7528\u90A3\u4E9B\u836F\u7269\u4E86\u3002\u95E8\u5916\uFF0C\u98CE\u7A7F\u8FC7\u6811\u53F6\u7684\u6C99\u6C99\u58F0\u3001\u8FDC\u5904\u8FDE\u7EF5\u7684\u866B\u9E23\u548C\u8F66\u6D41\uFF0C\u4E00\u6CE2\u53C8\u4E00\u6CE2\u6E29\u67D4\u7684\u6D9F\u6F2A\u5C06\u6211\u56F4\u7ED5\uFF0C\u6211\u7EC8\u4E8E\u4E0D\u518D\u75DB\u6068\u8FD9\u4E2A\u4E16\u754C\uFF0C\u4E0D\u518D\u75DB\u6068\u6211\u81EA\u5DF1\u3002\n\n\u6211\u5F88\u5E86\u5E78\u836F\u7269\u6CA1\u6709\u5265\u593A\u6211\u5BF9\u4F60\u7684\u601D\u5FF5\uFF0C\u4ECA\u540E\uFF0C\u6211\u4E5F\u4F1A\u5E26\u7740\u8FD9\u4EFD\u601D\u5FF5\uFF0C\u4E00\u76F4\u4E00\u76F4\u5730\u8D70\u4E0B\u53BB\u3002\n\n\u4F46\u5728\u8FD9\u5C01\u4FE1\u7684\u65F6\u95F4\u91CC\uFF0C\u8BF7\u518D\u5141\u8BB8\u6211\u77ED\u6682\u5730\u7559\u604B\u4E00\u4E0B\u5427\u3002\n\n____\n\n\u5236\u4F5C\u540D\u5355\uFF1A\n\u4E3B\u7A0B\u5E8F\uFF1AAstra_OwO\r\n\u7A0B\u5E8F+\u97F3\u4E50\uFF1AReyar\r\n\u5267\u60C5+\u7F8E\u672F\uFF1AHirycptp\r\n\u5173\u5361\uFF1AArsnicca\r\n\u7B56\u5212+\u89C6\u89C9\u6307\u5BFC\uFF1A\u767D\u5B87BaiYu.\n\n\u611F\u8C22\u4F60\u7684\u6E38\u73A9"

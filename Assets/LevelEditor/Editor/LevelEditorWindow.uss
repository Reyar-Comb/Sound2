.level-editor { padding: 10px; flex-grow: 1; }
.title { font-size: 20px; -unity-font-style: bold; margin-bottom: 6px; color: rgb(112, 218, 218); }
.hint { white-space: normal; margin-top: 6px; margin-bottom: 8px; color: rgb(192, 201, 209); }
.toolbar-row { flex-direction: row; flex-wrap: wrap; margin-top: 4px; margin-bottom: 4px; }
.toolbar-row > Button { min-width: 78px; min-height: 25px; margin-right: 4px; margin-bottom: 4px; }
.active-tool { background-color: rgb(35, 102, 112); color: white; }
.section { margin-top: 10px; margin-bottom: 6px; -unity-font-style: bold; font-size: 13px; }
.item { min-height: 26px; -unity-text-align: middle-left; }
.selected-item { background-color: rgb(37, 92, 104); color: white; }
.primary { background-color: rgb(36, 110, 119); color: white; min-height: 30px; }
.properties { margin-top: 6px; padding: 8px; background-color: rgba(0, 0, 0, 0.15); }
.status { white-space: normal; margin-top: 8px; padding: 8px; background-color: rgba(0, 0, 0, 0.2); }
.error { color: rgb(255, 174, 103); }
ScrollView { flex-grow: 1; }
